rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is admin
    function isAdmin() {
      return request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        request.auth.token.email == 'f.sprinterstore91@gmail.com'
      );
    }

    // Function to check if user owns the document
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // 1. PRODUCTS & CATEGORIES
    // Anyone can read products, variants, and categories. Only admins can write.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
      
      match /variants/{variantId} {
        allow read: if true;
        allow write: if isAdmin();
      }
      
      match /reviews/{reviewId} {
        allow read: if true;
        // Anyone can create a review if they are logged in (could restrict to verified buyers later)
        allow create: if request.auth != null;
        allow update, delete: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.userId);
      }
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. USERS & ADDRESSES & CUSTOMERS
    // Users can read/write their own data. Admins can read/write all.
    match /customers/{phone} {
      allow read: if isAdmin();
      allow write: if true; // Allow guest checkout to update customer profile
    }
    // Users can read/write their own data. Admins can read/write all.
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      
      match /addresses/{addressId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // 3. ARTWORKS
    // Users can read/write their own artworks. Guests can create but need session ID matching. Admins can read all.
    match /artworks/{artworkId} {
      // Allow read if admin or if the user is the uploader
      allow read: if isAdmin() || (request.auth != null && resource.data.uploaderId == request.auth.uid) || (resource.data.uploaderId == request.resource.data.uploaderId);
      // Anyone can create an artwork (guests or users)
      allow create: if true;
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.uploaderId == request.auth.uid);
    }

    // 4. CARTS
    // Users/Guests can read/write their own carts
    match /carts/{cartId} {
      // Authenticated users can only access their own cart; guests can access any guest cart. Auth users can also access guest carts for merging.
      allow read, write: if request.auth == null || cartId == request.auth.uid || cartId.matches('^guest_.*');
    }

    // 5. ORDERS & TIMELINES
    // Users can read their own orders. Anyone can create an order (guest checkout). Admins can manage all.
    match /orders/{orderId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.customerId == request.auth.uid);
      allow create: if true; // Allow guest checkout creation
      allow update: if isAdmin() || resource.data.customerId == request.resource.data.customerId;
      allow delete: if isAdmin();
      
      match /timeline/{timelineId} {
        allow read: if isAdmin() || (request.auth != null && get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid);
        allow create: if true; // Allow system/client to create the initial event
        allow update, delete: if isAdmin();
      }
    }

    // 6. COUPONS
    // Anyone can read active coupons, only admins can create/delete/full update.
    // Users (even guests) can update the usedCount atomically when checking out.
    match /coupons/{couponId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount', 'updatedAt']) && 
        request.resource.data.usedCount == resource.data.usedCount + 1 && 
        resource.data.isActive == true
      );
    }

    // 7. SETTINGS
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
